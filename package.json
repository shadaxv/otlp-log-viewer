{
  "name": "otlp-log-viewer-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @otlp-log-viewer/web dev",
    "build": "pnpm --filter @otlp-log-viewer/web build",
    "start": "pnpm --filter @otlp-log-viewer/web start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "pnpm --filter @otlp-log-viewer/web typecheck",
    "test": "pnpm --filter @otlp-log-viewer/web test"
  },
  "devDependencies": {
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0"
  },
  "packageManager": "pnpm@10.30.3"
}
