{
  "name": "otlp-log-viewer-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @otlp-log-viewer/web --filter @otlp-log-viewer/api --parallel run dev",
    "dev:web": "pnpm --filter @otlp-log-viewer/web dev",
    "dev:api": "pnpm --filter @otlp-log-viewer/api dev",
    "convex:setup": "pnpm --filter @otlp-log-viewer/api run setup",
    "build": "pnpm --recursive --if-present run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test"
  },
  "devDependencies": {
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0"
  },
  "packageManager": "pnpm@10.30.3"
}
